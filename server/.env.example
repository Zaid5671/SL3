# MongoDB Atlas connection string
MONGO_URI=

# Secret for signing JWT tokens (use a long random string)
JWT_SECRET=

# Groq API key for AI summarization and context feed
GROQ_API_KEY=

# Comma-separated list of allowed frontend origins (no trailing slash)
# Local dev default is http://localhost:5173 if unset
# Production example: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# Server port (Render sets PORT automatically)
PORT=5000

# Optional scraping configuration
# SCRAPE_MIN_CONTENT_CHARS=200
# SCRAPE_STATIC_TIMEOUT_MS=15000
# SCRAPE_PUPPETEER_TIMEOUT_MS=30000
# PUPPETEER_HEADLESS=true
